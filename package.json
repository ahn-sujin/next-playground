{
  "name": "next-playground",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "NODE_OPTIONS='--inspect' turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format . --write",
    "check": "biome check . --write",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "turbo": "^2.4.4",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
